{
  "name": "affiliate-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js --ignore ../frontend",
    "client": "npm run dev --prefix ../frontend",
    "start": "node server.js",
    "start:prod": "node server.js",
    "build": "npm install --prefix ../frontend && npm run build --prefix ../frontend",
    "install-client": "npm install --prefix ../frontend"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "nodemailer": "^8.0.7",
    "uuid": "^9.0.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
